<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.3</version>
		<relativePath />
	</parent>
	<groupId>com.commercehub</groupId>
	<artifactId>commerce-hub</artifactId>
	<version>1.0.0</version>
	<packaging>pom</packaging>
	<properties>
		<java.version>25</java.version>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>
	<!-- Override transitive dependency versions to fix known security vulnerabilities. -->
	<dependencyManagement>
		<dependencies>
			<!-- LZ4 security update -->
			<dependency>
				<groupId>at.yawk.lz4</groupId>
				<artifactId>lz4-java</artifactId>
				<version>1.11.4</version>
			</dependency>

			<!-- Snappy security update -->
			<dependency>
				<groupId>org.xerial.snappy</groupId>
				<artifactId>snappy-java</artifactId>
				<version>1.1.10.9</version>
			</dependency>
		</dependencies>
	</dependencyManagement>
	<modules>
		<module>user-service</module>
		<module>java-core-lab</module>
		<module>notification-service</module>
		<module>spring-ai-lab</module>
		<module>spring-integration-lab</module>
	</modules>
</project>
